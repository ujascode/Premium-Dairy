"use client";
import { useEffect, useState } from 'react';

export default function Dashboard() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const fetchData = async () => {
      try {
        setLoading(true);
        const [statsRes, chartRes] = await Promise.all([
          fetch('/api/dashboard/stats'),
          fetch('/api/dashboard/sales-chart?range=30days')
        ]);
        const [statsData, chartDataResult] = await Promise.all([
          statsRes.json(),
          chartRes.json()
        ]);
        setData({ stats: statsData, chart: chartDataResult });
      } catch (err) {
        console.error('Error fetching dashboard data:', err);
      } finally {
        setLoading(false);
      }
    };

    fetchData();
  }, []);

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gray-50">
        <div className="text-center space-y-4">
          <div className="inline-block">
            <div className="h-4 w-4 rounded-full bg-primary/50 mb-2"></div>
            <div className="h-4 w-4 rounded-full bg-primary/50 mb-2"></div>
            <div className="h-4 w-4 rounded-full bg-primary/50"></div>
          </div>
          <p className="text-sm text-muted-foreground">Loading dashboard data...</p>
        </div>
      </div>
    );
  }

  if (!data) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <p className="text-center">Loading dashboard...</p>
      </div>
    );
  }

  const { stats, chart } = data;

  return (
    <div className="min-h-screen bg-gray-50">
      <div className="max-w-7xl mx-auto px-4 py-8">
        <h1 className="text-2xl font-bold text-foreground mb-6">
          Dashboard Overview
        </h1>
        
        <div className="grid gap-6 mb-8 sm:grid-cols-2 lg:grid-cols-4">
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-medium text-muted-foreground">Daily Milk Production</span>
              <span className="px-2 py-1 bg-primary/20 text-primary rounded-full text-xs font-medium">
                {stats.dailyMilkProduction}L
              </span>
            </div>
            <p className="text-2xl font-bold text-foreground mt-2">
              {stats.dailyMilkProduction.toLocaleString()}
            </p>
          </div>
          
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-medium text-muted-foreground">Monthly Revenue</span>
              <span className="px-2 py-1 bg-primary/20 text-primary rounded-full text-xs font-medium">
                ${stats.monthlyRevenue}
              </span>
            </div>
            <p className="text-2xl font-bold text-foreground mt-2">
              ${stats.monthlyRevenue.toLocaleString()}
            </p>
          </div>
          
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-medium text-muted-foreground">Total Livestock</span>
              <span className="px-2 py-1 bg-primary/20 text-primary rounded-full text-xs font-medium">
                {stats.totalLivestock}
              </span>
            </div>
            <p className="text-2xl font-bold text-foreground mt-2">
              {stats.totalLivestock.toLocaleString()}
            </p>
          </div>
          
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <div className="flex items-center justify-between mb-3">
              <span className="text-sm font-medium text-muted-foreground">Growth Rate</span>
              <span className={`px-2 py-1 bg-${stats.growthRate >= 0 ? 'success' : 'error'}/20 text-${stats.growthRate >= 0 ? 'success' : 'error'} rounded-full text-xs font-medium`}>
                {stats.growthRate >= 0 ? '+' : ''}{stats.growthRate}%
              </span>
            </div>
            <p className="text-2xl font-bold text-foreground mt-2">
              {stats.growthRate >= 0 ? '+' : ''}{stats.growthRate}%
            </p>
          </div>
        </div>
        
        <div className="grid gap-6">
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <h2 className="mb-4 font-semibold text-foreground">Production Chart</h2>
            <div className="h-96">
              {chart && chart.length > 0 ? (
                <div className="w-full h-full">
                  {/* Chart would go here - simplified for now */}
                  <div className="h-full w-full bg-gray-200 rounded-lg flex items-center justify-center">
                    <p className="text-sm text-muted-foreground">Chart visualization</p>
                  </div>
                </div>
              ) : (
                <div className="h-full flex items-center justify-center">
                  <p className="text-sm text-muted-foreground">No chart data available</p>
                </div>
              )}
            </div>
          </div>
          
          <div className="bg-white rounded-xl border border-border/20 p-6">
            <h2 className="mb-4 font-semibold text-foreground">Recent Activity</h2>
            <div className="space-y-4">
              <div className="p-4 bg-gray-50 rounded-lg">
                <div className="flex justify-between items-start">
                  <div className="flex-shrink-0 h-8 w-8 flex items-center justify-center bg-primary/10 rounded-lg">
                    <span className="text-primary">📊</span>
                  </div>
                  <div className="ml-3">
                    <p className="font-medium text-foreground">Daily report generated</p>
                    <p className="text-sm text-muted-foreground">2 hours ago</p>
                  </div>
                </div>
              </div>
              <div className="p-4 bg-gray-50 rounded-lg">
                <div className="flex justify-between items-start">
                  <div className="flex-shrink-0 h-8 w-8 flex items-center justify-center bg-primary/10 rounded-lg">
                    <span className="text-primary">🐄</span>
                  </div>
                  <div className="ml-3">
                    <p className="font-medium text-foreground">New livestock added</p>
                    <p className="text-sm text-muted-foreground">5 hours ago</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
}
